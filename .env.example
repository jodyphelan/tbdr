# Copy this file to .env before starting Compose.
POSTGRES_DB=tbdr
POSTGRES_USER=tbdr
POSTGRES_PASSWORD=replace-with-a-long-password
TBDR_SECRET_KEY=replace-with-a-long-random-secret
UPLOADED_SAMPLES_PUBLIC=false

# Optional local resource and port overrides.
TBDR_WEB_PORT=8000
TBDR_PROFILE_THREADS=2
TBDR_PROFILE_RAM_GB=8
TBDR_CELERY_CONCURRENCY=1
